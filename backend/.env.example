# Google Gemini API key for Chatbot, RAG Answer Generation, and Voice Study Planner
GEMINI_API_KEY=

# Gemini model (default: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# WeatherAPI key (https://www.weatherapi.com/) - kept strictly on the backend
WEATHERAPI_API_KEY=

# Firebase Admin credentials (use path OR inline JSON, never commit private files)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local RAG storage settings
CHROMA_PERSIST_DIR=./chroma_db
UPLOAD_DIR=./uploads
EMBEDDING_MODEL=gemini-embedding-001
